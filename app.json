{
  "expo": {
    "name": "Mountain Mate Partner App",
    "slug": "mountain-mate-partner-app",
    "version": "0.1.0",
    "scheme": "mountainmatepartner",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "in.mountainmate.partner",
      "adaptiveIcon": {
        "backgroundColor": "#0E1A16"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mountain Mate Partner uses your location to power live driver tracking, nearby ride discovery, route previews, and SOS support."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7D5A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5ce05770-f23d-482e-bf28-85d7f81f0717"
      }
    },
    "owner": "mountainmate.app"
  }
}
